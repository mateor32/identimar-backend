# PostgreSQL (Supabase connection string)
DATABASE_URL=postgres://postgres:password@host:5432/postgres
# Pon "false" solo para desarrollo contra una BD local sin SSL
DATABASE_SSL=true

# Supabase Storage
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cambia-esto
SUPABASE_BUCKET=observaciones

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# Servicio de visión (Equipo 2)
# Endpoint HTTPS que recibe { id_observacion, url_imagen } y responde con la predicción.
VISION_API_URL=https://vision.example.com/predict
VISION_API_KEY=cambia-esto
# Endpoint de feedback (dataset de reentrenamiento). Opcional: si falta se
# saltean los envíos y la validación experta sigue funcionando.
VISION_FEEDBACK_URL=https://identimar-vision-1041648874347.us-central1.run.app/feedback

# App
PORT=3000
